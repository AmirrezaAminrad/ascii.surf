{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // DOM lib is needed because imported web modules (themes.ts, state.ts) are
    // typechecked in this program too; the CLI source itself never touches DOM.
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node"],

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
